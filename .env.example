# MedFlow Environment Configuration
# Copy this file to .env and update the values

# MedGemma Remote Service (Required for VLM processing)
# Get this URL from your Google Colab ngrok output
MEDGEMMA_REMOTE_URL=

# MongoDB Configuration (Optional - defaults work with Docker Compose)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=medflow

# Redis Configuration (Optional - defaults work with Docker Compose)
REDIS_URL=redis://localhost:6379/0

# Security (Change in production!)
SECRET_KEY=your-secret-key-change-in-production

# CORS Configuration (Add your frontend URLs)
# Note: Use single quotes around JSON arrays to prevent shell parsing errors
BACKEND_CORS_ORIGINS='["http://localhost:5173","http://localhost:3000"]'

# Debug Mode
# DEBUG=True
